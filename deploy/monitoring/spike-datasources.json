{
  "apiVersion": 1,
  "datasources": [
    {
      "name": "VictoriaLogs",
      "uid": "expenis-logs",
      "type": "victoriametrics-logs-datasource",
      "access": "proxy",
      "url": "http://logs:9428",
      "jsonData": {
        "derivedFields": [
          {
            "name": "trace_id",
            "matcherType": "label",
            "matcherRegex": "trace_id",
            "datasourceUid": "expenis-traces",
            "url": "$${__value.raw}"
          }
        ]
      }
    },
    {
      "name": "Tempo",
      "uid": "expenis-traces",
      "type": "tempo",
      "access": "proxy",
      "url": "http://tempo:3200",
      "jsonData": {
        "tracesToLogsV2": {
          "datasourceUid": "expenis-logs",
          "spanStartTimeShift": "-5m",
          "spanEndTimeShift": "5m",
          "customQuery": true,
          "query": "environment:=\"$${__span.tags.environment}\" trace_id:=\"$${__trace.traceId}\""
        }
      }
    },
    {
      "name": "VictoriaMetrics",
      "uid": "P4169E866C3094E38",
      "type": "prometheus",
      "access": "proxy",
      "url": "http://metrics:8428"
    }
  ]
}
